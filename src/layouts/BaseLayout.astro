---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "UcnacDx2's Blog",
  description = '技术、项目与随笔',
} = Astro.props;

const pageTitle = title === "UcnacDx2's Blog" ? title : `${title} · UcnacDx2's Blog`;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        background: #f7f7f5;
        color: #1f2328;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        background: #f7f7f5;
        color: #1f2328;
        line-height: 1.75;
      }

      a { color: inherit; }

      .shell {
        width: min(760px, calc(100% - 40px));
        margin: 0 auto;
      }

      header {
        padding: 40px 0 22px;
        border-bottom: 1px solid #deded9;
      }

      .brand {
        font-size: 1.05rem;
        font-weight: 700;
        text-decoration: none;
      }

      main { padding: 48px 0 80px; }

      footer {
        border-top: 1px solid #deded9;
        padding: 24px 0 40px;
        color: #6b6f76;
        font-size: .9rem;
      }

      h1, h2, h3 { line-height: 1.25; }
      h1 { font-size: clamp(2rem, 7vw, 3.5rem); margin: 0 0 16px; }
      h2 { margin-top: 2.2em; }

      p, li { font-size: 1.04rem; }
      code { font-family: "SFMono-Regular", Consolas, monospace; }
      pre { overflow-x: auto; padding: 18px; border-radius: 12px; background: #ecece7; }
      blockquote { margin-left: 0; padding-left: 18px; border-left: 3px solid #aaa; color: #5e6268; }

      @media (prefers-color-scheme: dark) {
        :root, body { background: #111315; color: #eceff1; }
        header, footer { border-color: #30343a; }
        footer, .muted { color: #a4a9af; }
        pre { background: #1d2024; }
      }
    </style>
  </head>
  <body>
    <header>
      <div class="shell">
        <a class="brand" href="/">UcnacDx2's Blog</a>
      </div>
    </header>
    <main class="shell">
      <slot />
    </main>
    <footer>
      <div class="shell">© {new Date().getFullYear()} UcnacDx2 · Built with Astro & GitHub Pages</div>
    </footer>
  </body>
</html>
